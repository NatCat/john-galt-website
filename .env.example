# Admin Panel Credentials
# Copy this file to .env and set your own credentials
# NEVER commit .env to git - it's already in .gitignore

ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here

# For GitHub Pages deployment, set these as GitHub Secrets:
# - Go to your repository Settings > Secrets and variables > Actions
# - Add ADMIN_USERNAME and ADMIN_PASSWORD as repository secrets
# - They will be available during the build process
