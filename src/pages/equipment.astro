---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Contact from "../components/Contact.astro";
import "../styles/tailwind.css";
import { getLocaleFromUrl, getPageBySlugAndLocale } from "../lib/i18n";
import { getTranslation } from "../lib/translations";

const locale = getLocaleFromUrl(Astro.url);
const pageEntry = await getPageBySlugAndLocale('pages', 'equipment', locale).catch(() => null);
const pageData = pageEntry?.data ?? {};
const equipmentData = pageData.equipment ?? {};
const intro = equipmentData.intro ?? {};
const categories = equipmentData.categories ?? [];

// Get contact data from equipment page or home page
let contactData = pageData.contact;
if (!contactData) {
  const homeEntry = await getPageBySlugAndLocale('pages', 'home', locale).catch(() => null);
  const homeData = homeEntry?.data ?? {};
  contactData = homeData.contact;
}

// Icon paths for equipment categories
const equipmentIcons: Record<string, string> = {
  'Valves & Flow Control': 'M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4',
  'Water Treatment Systems': 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z',
  'Measurement & Monitoring': 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
  'Processing Equipment': 'M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z',
  'Automation & Control': 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  'Industrial Components': 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4',
};
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageData.description || 'Industrial equipment and automation solutions'} />
    <title>{pageData.title || getTranslation(locale, 'equipment')} - John Galt</title>
  </head>
  <body class="min-h-screen bg-white">
    <Header locale={locale} />
    <main class="pt-20">
      <section class="bg-gradient-to-b from-[#2d4a7c]/5 to-white pt-12 pb-6">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center max-w-3xl mx-auto">
            <h1 class="text-4xl md:text-5xl font-serif text-gray-900 mb-4">
              {pageData.title || getTranslation(locale, 'equipment')}
            </h1>
            {pageData.description && (
              <p class="text-xl text-gray-600">{pageData.description}</p>
            )}
          </div>
        </div>
      </section>

      <section class="pt-6 pb-12 bg-white">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          {(intro.heading || intro.description) && (
            <div class="text-center mb-8">
              {intro.heading && (
                <h2 class="text-3xl md:text-4xl font-serif text-gray-900 mb-3">
                  {intro.heading}
                </h2>
              )}
              {intro.description && (
                <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                  {intro.description}
                </p>
              )}
            </div>
          )}

          {categories.length > 0 ? (
            <div class="space-y-8">
              {categories.map((category) => 
                category.items && category.items.length > 0 ? (
                  <div class="bg-white rounded-xl border border-gray-200 p-8 shadow-sm">
                    {category.title && (
                      <h3 class="text-2xl font-serif text-gray-900 mb-6">
                        {category.title}
                      </h3>
                    )}
                    <ul class="space-y-3">
                      {category.items.map((item) => (
                        <li class="flex items-start gap-3">
                          <div class="flex-shrink-0 mt-1">
                            <div class="w-5 h-5 bg-[#2d4a7c] rounded-full flex items-center justify-center">
                              <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                              </svg>
                            </div>
                          </div>
                          <span class="text-gray-700 text-base leading-relaxed">{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ) : null
              )}
            </div>
          ) : (
            <div class="text-center py-12">
              <p class="text-gray-600 text-lg">Content coming soon...</p>
            </div>
          )}
        </div>
      </section>

      <!-- Contact Section -->
      <Contact data={contactData} />
    </main>
    <Footer locale={locale} />
  </body>
</html>

